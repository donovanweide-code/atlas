[Unit]
Description=Sportpaleis website cataloguscontrole
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
User=wbdapp
Group=wbdapp
WorkingDirectory=/srv/wbd/current/website
EnvironmentFile=/etc/wbd/production.env
ExecStart=/usr/bin/node scripts/sportpaleis-website-sync-job.mjs --scheduled
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/wbd/shared
