{
  "probe": {
    "attempts": 4,
    "intervalMs": 5000,
    "timeoutMs": 8000,
    "maxBodyBytes": 1048576
  },
  "validation": {
    "maximumEvidenceAgeSeconds": 1800,
    "minimumConsecutiveSamples": 2,
    "minimumIndependentRoutes": 2,
    "minimumObservationSpanMs": 15000
  },
  "execution": {
    "approvedRunnerContexts": [
      {
        "id": "codex-network-enabled",
        "networkCapable": true,
        "networkContexts": [
          "transip-ipv4",
          "transip-ipv6"
        ]
      }
    ],
    "localPermissionErrorCodes": [
      "EACCES",
      "EPERM"
    ],
    "localPermissionRetryLimit": 1
  },
  "endpoints": {
    "target": {
      "url": "https://webuildanddesign.nl/",
      "assertions": [
        {
          "id": "production-status",
          "type": "status",
          "equals": 200,
          "critical": true
        },
        {
          "id": "canonical-js-bundle",
          "type": "bodyIncludes",
          "value": "/assets/index-DX1T5CEV.js",
          "critical": true
        },
        {
          "id": "canonical-css-bundle",
          "type": "bodyIncludes",
          "value": "/assets/index-DWjRSiTi.css",
          "critical": true
        },
        {
          "id": "production-is-indexable",
          "type": "headerExcludes",
          "name": "x-robots-tag",
          "value": "noindex",
          "critical": true
        }
      ]
    },
    "control": {
      "url": "https://preview.webuildanddesign.nl/",
      "assertions": [
        {
          "id": "control-status",
          "type": "status",
          "equals": 200,
          "critical": true
        },
        {
          "id": "control-js-bundle",
          "type": "bodyIncludes",
          "value": "/assets/index-DX1T5CEV.js",
          "critical": true
        },
        {
          "id": "control-css-bundle",
          "type": "bodyIncludes",
          "value": "/assets/index-DWjRSiTi.css",
          "critical": true
        },
        {
          "id": "control-is-not-indexable",
          "type": "headerIncludes",
          "name": "x-robots-tag",
          "value": "noindex",
          "critical": true
        }
      ]
    }
  }
}
