{
  "probe": {
    "attempts": 4,
    "intervalMs": 5000,
    "timeoutMs": 8000,
    "maxBodyBytes": 1048576
  },
  "validation": {
    "maximumEvidenceAgeSeconds": 600,
    "minimumConsecutiveSamples": 2,
    "minimumIndependentRoutes": 2,
    "minimumObservationSpanMs": 15000
  },
  "endpoints": {
    "target": {
      "url": "https://webuildanddesign.nl/",
      "assertions": [
        {
          "id": "production-status",
          "type": "status",
          "equals": 200,
          "critical": true
        },
        {
          "id": "canonical-js-bundle",
          "type": "bodyIncludes",
          "value": "/assets/index-REPLACE.js",
          "critical": true
        },
        {
          "id": "canonical-css-bundle",
          "type": "bodyIncludes",
          "value": "/assets/index-REPLACE.css",
          "critical": true
        },
        {
          "id": "production-is-indexable",
          "type": "headerExcludes",
          "name": "x-robots-tag",
          "value": "noindex",
          "critical": true
        }
      ]
    },
    "control": {
      "url": "https://preview.webuildanddesign.nl/",
      "assertions": [
        {
          "id": "control-status",
          "type": "status",
          "equals": 200,
          "critical": true
        }
      ]
    }
  }
}
