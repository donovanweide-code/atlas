NODE_ENV=production
APP_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=https://webuildanddesign.nl
WORKSPACE_BASE_URL=https://workspace.sportpaleis.nl
WBD_WORKSPACE_BASE_URL=https://workspace.webuildanddesign.nl
RELEASE_ID=REPLACE_WITH_IMMUTABLE_RELEASE_ID
WORKSPACE_DIST_DIR=dist-workspace
LOG_LEVEL=info

WORKSPACE_DB_HOST=127.0.0.1
WORKSPACE_DB_PORT=3306
WORKSPACE_DB_NAME=wbd_workspace
WORKSPACE_DB_USER=wbd_workspace_app
WORKSPACE_DB_PASSWORD=REPLACE_VIA_LOCAL_SECRET_HANDOFF

ATLAS_DB_HOST=127.0.0.1
ATLAS_DB_PORT=3306
ATLAS_DB_NAME=wbd_atlas
ATLAS_DB_USER=wbd_atlas_app
ATLAS_DB_PASSWORD=REPLACE_VIA_LOCAL_SECRET_HANDOFF

SPORTPALEIS_UPLOADS_ENABLED=false
SPORTPALEIS_PRODUCTION_ASSET_UPLOADS_ENABLED=true
SPORTPALEIS_FONT_UPLOADS_ENABLED=true
SPORTPALEIS_MAIL_MODE=capture
# Standalone Creative Studio is outside the controlled Bedrukken pilot.
SPORTPALEIS_CREATIVE_STUDIO_ENABLED=false
SPORTPALEIS_HARDWARE_OUTPUT_ENABLED=false
SPORTPALEIS_DIRECT_PRINT_ENABLED=false
SPORTPALEIS_SUMMA_ENABLED=false
# Non-secret, comma-separated canonical principal IDs. Empty means Review Mode is unavailable.
SPORTPALEIS_REVIEW_PRINCIPAL_IDS=user-0000000000000000
# Temporary Codex review/developer access is disabled unless all three values are explicit.
# Candidate and issuer IDs are non-secret; activation/session tokens are generated at runtime and only their hashes persist.
SPORTPALEIS_ACTIVE_REVIEW_CANDIDATE_IDS=
WBD_REVIEW_ACCESS_ENABLED=false
WBD_REVIEW_ACCESS_ISSUER_IDS=
ATLAS_RUNTIME_MODE=boundary-only
DEBUG=false
