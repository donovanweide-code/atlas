# Niet hernoemen naar een gedeeld of gecommit secretsbestand.
WBD_MAIL_MODE=CONTROLLED_SMTP_TEST
WBD_CONTROLLED_SMTP_ENABLED=NO
WBD_SMTP_TEST_RECIPIENT=NOT_PROVISIONED

WBD_SMTP_INFO_USERNAME=NOT_PROVISIONED
WBD_SMTP_INFO_PASSWORD=NOT_PROVISIONED
WBD_SMTP_INVOICE_USERNAME=NOT_PROVISIONED
WBD_SMTP_INVOICE_PASSWORD=NOT_PROVISIONED

WBD_SMTP_CONNECTION_TIMEOUT_MS=10000
WBD_SMTP_SEND_TIMEOUT_MS=15000
WBD_PRODUCTION_SMTP_ENABLED=NO

# Standard Web Push, zonder betaalde provider. Provisioneer signing keys uitsluitend via de gecontroleerde secretprocedure.
WBD_PUSH_VAPID_PUBLIC_KEY=NOT_PROVISIONED
WBD_PUSH_VAPID_PRIVATE_KEY=NOT_PROVISIONED
WBD_PUSH_VAPID_SUBJECT=mailto:security@webuildanddesign.nl

# Sportpaleis Mail 005 - niet combineren met WBD_MAIL_MODE als de waarden verschillen.
SPORTPALEIS_MAIL_MODE=CONTROLLED_SMTP_TEST
SPORTPALEIS_CONTROLLED_SMTP_ENABLED=NO
SPORTPALEIS_SMTP_TEST_RECIPIENT=NOT_PROVISIONED

SPORTPALEIS_SMTP_HOST=mail.hostingserver.nl
SPORTPALEIS_SMTP_PORT=465
SPORTPALEIS_SMTP_BEDRUKKING_USERNAME=bedrukking@sportpaleis.nl
SPORTPALEIS_SMTP_BEDRUKKING_PASSWORD=NOT_PROVISIONED

SPORTPALEIS_SMTP_CONNECTION_TIMEOUT_MS=10000
SPORTPALEIS_SMTP_SEND_TIMEOUT_MS=15000
SPORTPALEIS_PRODUCTION_SMTP_ENABLED=NO
